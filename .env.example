# Copy to .env and adjust. Every value has a safe default, so `docker compose up` works without it.

# ---------- Core ----------
ENVIRONMENT=development            # set to "production" to enforce a real SECRET_KEY
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32   # generate: openssl rand -hex 32
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
WEB_CONCURRENCY=2                  # API processes; use 1 on a 16 GB machine with voice on (each process loads its own Whisper + TTS)
FORWARDED_ALLOW_IPS=127.0.0.1      # proxy IPs trusted for X-Forwarded-For; set to * with the https profile + API_BIND=127.0.0.1
API_BIND=0.0.0.0                   # 127.0.0.1 = only reachable through the Caddy proxy (https profile)
OLLAMA_BIND=127.0.0.1              # Ollama port is only published to localhost
MAILPIT_BIND=127.0.0.1

# ---------- Auth ----------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=                  # OAuth client ID from Google Cloud Console (free); leave blank to disable /auth/google
REQUIRE_EMAIL_VERIFICATION=false   # true = password logins blocked until the email is verified
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFY_EXPIRE_HOURS=48
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123

# ---------- Phone login / OTP / SMS ----------
# SMS_PROVIDER: console (log only) | email_bridge (dev: SMS text lands in Mailpit, the compose default)
#               | webhook (POST JSON to any gateway, e.g. a self-hosted Android SMS gateway)
#               | twilio | msg91 | fast2sms
# Commercial SMS to Indian numbers needs DLT registration (sender ID + approved templates) with your provider.
SMS_PROVIDER=email_bridge
SMS_SENDER_NAME=Suraksha AI
SMS_EMAIL_BRIDGE_DOMAIN=sms.suraksha.local
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=                 # sent as "Authorization: Bearer <token>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=             # DLT-approved template ids
MSG91_ALERT_TEMPLATE_ID=
FAST2SMS_API_KEY=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5                 # wrong codes before the OTP is burned
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5                 # per phone number
DEFAULT_COUNTRY_CODE=91            # prefixed to 10-digit numbers

# ---------- Email ----------
# Defaults deliver to the bundled Mailpit catcher (read mail at http://localhost:8025).
# For real delivery use any SMTP provider, e.g. SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_STARTTLS=true.
EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
EMAIL_FROM=Suraksha AI <no-reply@suraksha.example>
FRONTEND_URL=http://localhost:3000  # links in emails: {FRONTEND_URL}/verify-email?token=... and /reset-password?token=...

# ---------- Privacy ----------
REQUIRE_CONSENT=true               # scans, chat, voice and family features need the privacy notice accepted (GET /privacy)
CONSENT_VERSION=2026-10            # change when the notice changes to ask every user again
ANALYSIS_RETENTION_DAYS=180        # delete analyses (redacted excerpts) after N days; 0 = keep. Uploads are deleted after reading.

# ---------- Rate limits (slowapi syntax) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_UPLOAD=10/minute

# ---------- PostgreSQL ----------
POSTGRES_USER=suraksha
POSTGRES_PASSWORD=suraksha
POSTGRES_DB=suraksha

# ---------- Ollama (local LLMs, no paid APIs) ----------
OLLAMA_PRIMARY_MODEL=llama3.1:8b       # scam analysis, chat, explanations, voice
OLLAMA_SECONDARY_MODEL=gemma2:9b       # lessons, quizzes, translations, nudges (set to llama3.1:8b to use one model only)
OLLAMA_EMBED_MODEL=nomic-embed-text    # RAG embeddings
OLLAMA_PULL_MODELS=nomic-embed-text llama3.1:8b gemma2:9b   # ~11 GB download
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=10m                  # how long a model stays in GPU memory after use; -1 = until stopped (best for a demo)
OLLAMA_NUM_CTX=8192                    # context window per request
# Memory tuning (defaults suit an 8 GB GPU such as an RTX 4060 with 16 GB RAM).
OLLAMA_NUM_PARALLEL=1                  # concurrent requests per model; 2+ needs more VRAM
OLLAMA_MAX_LOADED_MODELS=2             # one LLM + nomic-embed-text; llama3.1 and gemma2 swap when needed (a few seconds)
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0              # f16 = slightly higher quality, twice the KV memory
LLM_ENABLED=true
# Optional per-language model override (JSON), e.g. a stronger Indic model you have pulled yourself:
# OLLAMA_LANGUAGE_MODELS={"ta":"<a model you pulled>"}   (add it to OLLAMA_PULL_MODELS too)
OLLAMA_LANGUAGE_MODELS={}

# ---------- RAG ----------
CHROMA_COLLECTION=suraksha_knowledge
RAG_TOP_K=4
RAG_MIN_RELEVANCE=0.35
RAG_AUTO_INGEST=true
KNOWLEDGE_MAX_MB=25                # max size of an uploaded / fetched knowledge document

# ---------- Risk scoring (calibrate with: python scripts/evaluate_risk.py --calibrate) ----------
RISK_MEDIUM_THRESHOLD=25
RISK_HIGH_THRESHOLD=50
RISK_CRITICAL_THRESHOLD=75
RISK_LLM_WEIGHT=0.6
SCAN_MAX_TOKENS=600                     # cap on the AI answer per scan (shorter = faster)

# ---------- Uploads / OCR ----------
MAX_UPLOAD_MB=10
MAX_AUDIO_MB=15
MAX_PDF_PAGES=10
OCR_LANGUAGES=eng+hin               # always loaded; the user's language script (tam, ben, ...) is added per request

# ---------- Voice ----------
INSTALL_VOICE=true                 # build arg: false = smaller image without Whisper/Coqui
VOICE_ENABLED=true
WHISPER_MODEL=base                 # tiny | base | small | medium (small is better for Hindi, slower)
TTS_ENABLED=true
TTS_MODEL_EN=tts_models/en/ljspeech/vits
TTS_MODEL_MULTILINGUAL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_HINDI_SPEAKER=Ana Florence
# Extra voices for other languages (JSON: language -> model_path / config_path / optional vocoder_path,
# vocoder_config_path, speaker). Any Coqui-compatible checkpoint works, e.g. AI4Bharat Indic-TTS
# models copied into the "models" volume (mounted at /models):
# TTS_CUSTOM_MODELS={"ta":{"model_path":"/models/indic-tts/ta/fastpitch/best_model.pth","config_path":"/models/indic-tts/ta/fastpitch/config.json","speaker":"female"}}
TTS_CUSTOM_MODELS={}

# ---------- Web app (frontend service) ----------
FRONTEND_PORT=3000                 # open http://localhost:3000 ; the app calls the API through /api on the same origin
FRONTEND_BIND=0.0.0.0

# ---------- Backups (db-backup service) ----------
BACKUP_PATH=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_INITIAL_DELAY_SECONDS=900

# ---------- Off-machine backups (docker compose --profile offsite up -d) ----------
# Any rclone backend works; the remote is configured purely through RCLONE_CONFIG_<NAME>_* variables.
# Example: S3-compatible bucket (AWS, Backblaze B2 S3, Cloudflare R2, MinIO ...)
# BACKUP_REMOTE=offsite:my-bucket/suraksha
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
# RCLONE_CONFIG_OFFSITE_REGION=ap-south-1
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_INTERVAL_SECONDS=3600
BACKUP_REMOTE_RETENTION_DAYS=30    # 0 = never delete remote copies

# ---------- Monitoring (docker compose --profile monitoring up -d) ----------
METRICS_ENABLED=true
METRICS_TOKEN=                     # optional bearer token for /metrics (also configure deploy/prometheus/prometheus.yml)
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_RETENTION=15d

# ---------- HTTPS (docker compose --profile https up -d) ----------
DOMAIN=localhost                   # your public domain, e.g. api.suraksha.example (DNS must point here)
ACME_EMAIL=admin@example.com       # Let's Encrypt account / expiry notices
